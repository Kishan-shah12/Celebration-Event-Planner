# Planora Environment Variables Example
# Copy to .env for local development

# Flask Secret Key for session signing
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Google Gemini API Key (optional - deterministic offline fallback used if omitted)
GEMINI_API_KEY=

# Gemini Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Security Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60.0
